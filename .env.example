ASF_LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=5000
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://servicedeskgpt.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.3-chat
# Optional Azure reasoning-effort override; provider/model support varies.
AZURE_OPENAI_REASONING_EFFORT=
TAVILY_API_KEY=
LOG_LEVEL=INFO
ASF_LOG_FILE=data/logs/asf.log

# ASF model setup
# If ASF_MODELS is set, it is the full picker list (the built-ins above are not appended).
# Put every model you want to choose from in this JSON array; copy/edit entries to add more.
#
# Copy this JSON entry, then replace:
#   id              with a unique short name (letters, numbers, hyphens)
#   label           with the name shown in the chat model picker
#   base_url        with your provider's OpenAI-compatible API URL
#   model           with the exact model name your provider expects
#   api_key_env     with the name of the environment variable holding your key
#
# Put the actual secret on its own line, for example: MY_PROVIDER_API_KEY=your-secret-key
# Never put the secret value inside ASF_MODELS.
#
# This is a disabled example until you replace the URL/model and enter your key.
# The picker will show it as an option after ASF starts; it becomes selectable once its key is set.
ASF_MODELS='[{"id":"my-second-model","label":"My second model","provider_type":"openai_compatible","base_url":"https://your-provider.example/v1","model":"model-name-from-provider","api_key_env":"MY_PROVIDER_API_KEY"}]'
MY_PROVIDER_API_KEY=
# To start with this model selected, set: ASF_ACTIVE_MODEL=my-second-model
# For Azure use provider_type "azure_openai", "endpoint", "api_version", and an Azure key variable.
